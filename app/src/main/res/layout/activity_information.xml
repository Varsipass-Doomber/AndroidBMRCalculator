<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InformationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/result_textView_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Описание уровней активности"
            android:textAlignment="center"
            android:textSize="22dp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <TableRow android:gravity="center">

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="0.2"
                    android:background="@color/button_color"
                    android:text="Сидячий образ"
                    android:textStyle="bold" />

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:text="Нет работы или работа за столом" />
            </TableRow>

            <TableRow android:gravity="center">

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="0.2"
                    android:background="@color/button_color"
                    android:text="Маленькая активность"
                    android:textStyle="bold" />

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:text="Мало физических работы или занятия спортом 1-3 раза в неделю" />
            </TableRow>

            <TableRow android:gravity="center">

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="0.2"
                    android:background="@color/button_color"
                    android:text="Средняя активность"
                    android:textStyle="bold" />

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:text="Умеренная физическая работа или занятия спортом 3 - 5 дней в неделю" />
            </TableRow>

            <TableRow android:gravity="center">

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="0.2"
                    android:background="@color/button_color"
                    android:text="Сильная активность"
                    android:textStyle="bold" />

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:text="Сильные физическая нагрузка или занятия спортом 6 - 7 дней в неделю" />
            </TableRow>

            <TableRow android:gravity="center">

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="0.2"
                    android:background="@color/button_color"
                    android:text="Максимальная активность"
                    android:textStyle="bold" />

                <TextView
                    style="@style/table_textView_style"
                    android:layout_weight="1"
                    android:padding="20dp"
                    android:text="Сильная ежедневная физическая нагрузка или спорт и физическая работа" />
            </TableRow>


        </TableLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>